# Microsoft Azure App Registration (Outlook / Graph API)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback
MS_GRAPH_REFRESH_TOKEN=your-refresh-token-after-oauth

# Dropbox
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token

# Google Sheets (service account)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json
GOOGLE_PIPELINE_SHEET_ID=your-google-sheet-id

# Claude API (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ARIVE (for Claude Computer browser automation)
ARIVE_LOGIN_URL=https://arive.com/login
ARIVE_USERNAME=your-arive-username
ARIVE_PASSWORD=your-arive-password

# Andrea's shared mailbox
ANDREA_MAILBOX_EMAIL=andrea@yourdomain.com

# N8N
N8N_WEBHOOK_URL=http://localhost:5678
# Bearer token for the n8n MCP server (https://n8n.quetalk.ai/mcp-server/http), used by .mcp.json.
# Generate/rotate in n8n: Settings -> MCP server. Never commit the real token.
N8N_MCP_TOKEN=your-n8n-mcp-jwt

# General
LOG_LEVEL=info
EMAIL_SCAN_INTERVAL_MINUTES=15
DOCUMENT_CONFIDENCE_THRESHOLD=0.8

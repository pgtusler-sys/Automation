    {
      "parameters": {
        "jsCode": "// Build inbound-call context for the voice agent from the GHL contact lookup.\n// Look up custom fields by ID (robust to GHL field ordering), not by array position.\nconst c = ($json.contacts && $json.contacts[0]) || {};\nconst cf = c.customFields || [];\nconst byId = (id) => { const f = cf.find(x => x.id === id); return (f && f.value != null) ? f.value : \"\"; };\n\nreturn [{ json: {\n  call_inbound: {\n    custom_variables: {\n      \"full name\":  c.contactName || \"\",\n      \"Introduction\": byId(\"vadHuBnrarRKLvfcndG8\"), // custom_introduction\n      \"Notes\":        byId(\"IjxjwllVSYwz7opJCuVp\"), // lead_notes\n      \"Last Name\":  c.lastNameRaw || \"\",\n      \"Email\":      c.email || \"\"\n    }\n  }\n}}];\n"
      },
      "id": "code-ctx-0001",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "resp-ctx-0001",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [

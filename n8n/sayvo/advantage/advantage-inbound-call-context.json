        0
      ]
    },
    {
      "parameters": {
        "content": "## Advantage - Inbound Call Context\n\nSynthFlow POSTs user_phone_number; look up GHL contact; return custom_variables.\n\nFILL: REPLACE_GHL_LOCATION_ID + the two REPLACE_FIELD_ID_* in Build Context.\nGHL node: set the Advantage Bearer credential.\nResolves fields BY ID (not array position) so order changes don't break it.",
        "height": 280,
        "width": 520,
        "color": 5
      },

      "name": "GHL: Lookup Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Advantage — build inbound-call context. Resolve custom fields BY ID (not position).\nconst c = ($json.contacts && $json.contacts[0]) || {};\nconst cf = c.customFields || [];\nconst byId = (id) => { const f = cf.find(x => x.id === id); return (f && f.value != null) ? f.value : \"\"; };\nreturn [{ json: { call_inbound: { custom_variables: {\n  \"full name\": c.contactName || \"\",\n  \"Introduction\": byId(\"REPLACE_FIELD_ID_custom_introduction\"),\n  \"Notes\": byId(\"REPLACE_FIELD_ID_lead_notes\"),\n  \"Last Name\": c.lastNameRaw || \"\",\n  \"Email\": c.email || \"\"\n}}}}];\n"
      },
      "id": "adv-ctx-code",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "adv-ctx-resp",

{
  "name": "Pipeline Sync - Every 30 Minutes",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      },
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "command": "cd /home/user/Automation && npx ts-node src/index.ts sync"
      },
      "name": "Run Pipeline Sync",
      "type": "n8n-nodes-base.executeCommand",
      "position": [450, 300],
      "typeVersion": 1
    }
  ],
  "connections": {
    "Cron Trigger": {
      "main": [[{ "node": "Run Pipeline Sync", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
